<Window x:Class="GasPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="GAS PRO - Neural Core" Height="720" Width="1280"
        Background="#050505" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <!-- Aquí es donde SkiaSharp dibujará la magia a 60 FPS -->
        <skia:SKElement x:Name="LienzoNeuronal" PaintSurface="LienzoNeuronal_PaintSurface" />

        <!-- Un texto sutil superpuesto para saber el estado -->
        <TextBlock x:Name="TxtEstado" Text="SISTEMA EN REPOSO" 
                   Foreground="#00FFCC" FontFamily="Consolas" 
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                   Margin="0,0,0,30" Opacity="0.7"/>
    </Grid>
</Window>